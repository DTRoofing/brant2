# ===================================================================
# EXAMPLE ENVIRONMENT VARIABLES
#
# DO NOT COMMIT ACTUAL SECRETS TO THIS FILE.
# This file is a template. Copy it to .env and fill in your secrets.
# The .env file is ignored by git.
# ===================================================================

# --- Application Settings ---
APP_NAME="Brant Roofing System"
APP_VERSION="1.0.0"
DEBUG=True

# --- Database Configuration (PostgreSQL) ---
DATABASE_URL="postgresql+asyncpg://brant_user:brant_password@postgres:5432/brant_roofing"

# --- Redis Configuration (for Celery & Caching) ---
REDIS_URL="redis://redis:6379/0"

# --- Celery Worker Configuration ---
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/0"

# --- Google Cloud Memorystore Configuration ---
USE_MEMORYSTORE=false
MEMORYSTORE_REGION="us-central1"
MEMORYSTORE_INSTANCE_NAME="brant-redis-instance"

# --- LLM API Keys (Anthropic Claude) ---
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# --- Google Cloud Platform (GCP) Configuration ---
GCP_PROJECT="brant-roofing-system-2025"
GOOGLE_APPLICATION_CREDENTIALS="/app/google-credentials.json"
DOCUMENT_AI_PROCESSOR_ID="dc22888af5489eae"
GCS_BUCKET_NAME="your-gcs-bucket-name"