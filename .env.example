# ===================================================================
# EXAMPLE ENVIRONMENT VARIABLES FOR LOCAL DEVELOPMENT
# Copy this file to .env and fill in the values.
# ===================================================================

# --- Application Settings ---
# The secret key is used for signing sessions and tokens.
# Generate a new one for production. You can use `openssl rand -hex 32`
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# --- Database Configuration ---
# This URL points to the 'postgres' service defined in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://brant_user:brant_password@postgres:5432/brant_roofing

# --- Celery (Background Worker) Configuration ---
# These URLs point to the 'redis' service defined in docker-compose.yml
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Google Cloud Services ---
# These can be placeholders for local development if you are not using live GCP services.
GOOGLE_CLOUD_PROJECT_ID="your-gcp-project-id"
GOOGLE_CLOUD_STORAGE_BUCKET="your-gcs-bucket-name"

# --- Anthropic Claude API ---
ANTHROPIC_API_KEY="your-anthropic-api-key"